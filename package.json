{
  "name": "decision-safety-network",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:api": "npm run test --workspace apps/api --",
    "test:web": "npm run test --workspace apps/web --",
    "test:e2e": "npm run test:e2e --workspace apps/web --if-present",
    "emulators": "firebase emulators:start --only auth,firestore",
    "dev:api": "firebase emulators:exec --project demo-dsn --only auth,firestore \"PORT=8787 npx tsx apps/api/src/dev-server.ts\"",
    "dev:web": "npm --workspace apps/web run dev"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "firebase-tools": "15.32.0",
    "vitest": "5.0.2",
    "@types/node": "22.20.4"
  }
}
