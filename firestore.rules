rules_version = '2';

// The browser never reads or writes Firestore directly; only the
// authenticated Cloud Run API (using the Admin SDK, which bypasses these
// client rules) accesses case data. Deny all direct client access.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
